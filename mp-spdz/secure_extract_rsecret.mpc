"""Round 1 for --reveal-secret-projection: secret R, L2-normalised Y revealed row-shuffled under hybrid suppression."""

import copy
import sys

sys.path.insert(0, 'Programs/Source')

from Compiler.types import sint, sfix, cint, regint
from Compiler.library import (
    print_ln, for_range_opt_multithread, for_range_opt, public_input,
    break_point,
)
from Compiler import mpc_math

from mpc_utils.constants import NORM_SCALE
from mpc_utils import (
    build_pruned_merge_schedule,
    encoding_activity,
    encoding_bigram,
    encoding_ef,
    encoding_skip_bigram,
    encoding_trigram,
    expected_enc_dim,
    merge_and_extract,
    profile_timers,
    read_party_inputs,
)
from mpc_utils.perfect_sort import reveal_sort_checked

# Composite sort key PAD sentinel, as in secure_extract.mpc.
PAD_COMPOSITE = 2**40
CMP_BITS = 48

# Fingerprint width of the anonymous-set test, over the phi rows whose projection is revealed (a bigram fingerprint
# would under-suppress): weights span the full width, so a per-pair collision is at most 2^-37.
HASH_BITS = 48

# Parameters (compile-time Python ints).
try:
    N_CASES     = int(program.args[1]) if len(program.args) > 1 else 3
    PARTIAL_LEN = int(program.args[2]) if len(program.args) > 2 else 3
    DICT_SIZE   = int(program.args[3]) if len(program.args) > 3 else 6
    N_THREADS   = int(program.args[4]) if len(program.args) > 4 else 8
    K_PROJ      = int(program.args[5]) if len(program.args) > 5 else 50
    N_PARTIES   = int(program.args[6]) if len(program.args) > 6 else 3
    ENCODING    = int(program.args[7]) if len(program.args) > 7 else 0
    ENC_DIM_arg = int(program.args[8]) if len(program.args) > 8 else 0
    K_PRIV      = int(program.args[9]) if len(program.args) > 9 else 1
    TAU_NUM     = int(program.args[10]) if len(program.args) > 10 else 2000
    ADAPTIVE    = int(program.args[11]) if len(program.args) > 11 else 0
    NORM_PRESHIFT = int(program.args[12]) if len(program.args) > 12 else 2
    PLENS_arg   = program.args[13] if len(program.args) > 13 else ""
    # Extract-once reuse: CORE_MODE 2 = tail_only; such a run samples its own R, so its revealed Y is not a full run's.
    CORE_MODE     = int(program.args[14]) if len(program.args) > 14 else 0
    PERSIST_ENC   = int(program.args[15]) if len(program.args) > 15 else 0
    ENC_OFFSET    = int(program.args[16]) if len(program.args) > 16 else 0
    BIGRAM_OFFSET = int(program.args[17]) if len(program.args) > 17 else 0
    PROFILE       = int(program.args[18]) if len(program.args) > 18 else 0
except Exception:
    N_CASES, PARTIAL_LEN, DICT_SIZE, N_THREADS = 3, 3, 6, 8
    K_PROJ, N_PARTIES, ENCODING, ENC_DIM_arg = 50, 3, 0, 0
    K_PRIV = 1
    TAU_NUM = 2000
    ADAPTIVE = 0
    NORM_PRESHIFT = 2
    PLENS_arg = ""
    CORE_MODE = 0
    PERSIST_ENC = 0
    ENC_OFFSET = 0
    BIGRAM_OFFSET = 0
    PROFILE = 0

tick, tock = profile_timers(PROFILE)

# Per-party slice lengths: public compile metadata, aligned Rust-side to TRACE_LEN_ALIGNMENT, the disclosure class of L.
if PLENS_arg and PLENS_arg != "0":
    PARTIAL_LENS = [int(x) for x in PLENS_arg.split("x")]
    assert len(PARTIAL_LENS) == N_PARTIES, (PARTIAL_LENS, N_PARTIES)
    assert max(PARTIAL_LENS) == PARTIAL_LEN, (PARTIAL_LENS, PARTIAL_LEN)
else:
    PARTIAL_LENS = [PARTIAL_LEN] * N_PARTIES

# Width of the in-MPC L2 normalisation: parameters.rs::rsec_norm_preshift raises the even preshift until the
# worst-case |y|^2 fits the sfix(16, 31) cast, and divides by the matching scale.
assert NORM_PRESHIFT >= 2 and NORM_PRESHIFT % 2 == 0, "NORM_PRESHIFT must be even >= 2"
NORM_SCALE_F = 16
NORM_SCALE_INT = 1 << (NORM_SCALE_F + NORM_PRESHIFT // 2)
if NORM_PRESHIFT == 2:
    assert NORM_SCALE_INT == NORM_SCALE, "NORM_SCALE drift vs mpc_utils/constants.py"

ENC_DIM = ENC_DIM_arg if ENC_DIM_arg > 0 else DICT_SIZE * DICT_SIZE

# ENCODING: 0=bigram 1=EF 3=activity 4=trigram 5=skip-bigram. An over-wide ENC_DIM is silent, hence a compile error.
assert ENCODING != 2, "encoding flag 2 is not defined"
assert ENC_DIM == expected_enc_dim(ENCODING, DICT_SIZE), (
    "ENC_DIM %d != expected %d for ENCODING=%d at DICT_SIZE=%d"
    % (ENC_DIM, expected_enc_dim(ENCODING, DICT_SIZE), ENCODING, DICT_SIZE))
ENCODING_IS_BIGRAM = (ENCODING == 0)
if ENCODING == 1:
    encoding_extract = encoding_ef.extract_features
elif ENCODING == 3:
    encoding_extract = encoding_activity.extract_features
elif ENCODING == 4:
    encoding_extract = encoding_trigram.extract_features
elif ENCODING == 5:
    encoding_extract = encoding_skip_bigram.extract_features
else:
    encoding_extract = encoding_bigram.extract_features


ACTUAL_BIGRAMS = DICT_SIZE * DICT_SIZE

# The hash weights are public runtime input from a fresh per-run seed, so a collision is a per-run probability rather
# than a fixed property of the log, and the bytecode still caches across runs.
SUPPRESS = K_PRIV >= 2

# Compile-time merge tree schedule, consumed by mpc_utils.merge_and_extract.
_all_level_schedules, _totals = build_pruned_merge_schedule(N_PARTIES, PARTIAL_LENS)
_total_reversal_all = _totals["reversal"]
_total_oblivious_all = _totals["oblivious"]
_total_static_all = _totals["static"]

# Configuration summary.
print_ln("=== N-Party Merge Tree Configuration (reveal-secret-projection) ===")
print_ln("MODE: PRODUCTION - secret R, L2-normalised+shuffled Y revealed, π persisted for Round 2 relabel")
print_ln("N_PARTIES=%s  N_CASES=%s  PARTIAL_LEN=%s  DICT_SIZE=%s  K_PROJ=%s",
         N_PARTIES, N_CASES, PARTIAL_LEN, DICT_SIZE, K_PROJ)
print_ln("PARTIAL_LENS=%s", "x".join(str(l) for l in PARTIAL_LENS))
print_ln("ACTUAL_BIGRAMS=%s  ENC_DIM=%s", ACTUAL_BIGRAMS, ENC_DIM)
print_ln("K_PRIV=%s  SUPPRESS=%s (hybrid reveal: only anonymous rows opened)",
         K_PRIV, int(SUPPRESS))
print_ln("ADAPTIVE=%s  TAU_NUM=%s (budget-bounded threshold selected in-MPC when 1)",
         ADAPTIVE, TAU_NUM)
print_ln("NORM_PRESHIFT=%s  NORM_SCALE_INT=%s", NORM_PRESHIFT, NORM_SCALE_INT)
print_ln("CORE_MODE=%s (0=full,2=tail_only)  PERSIST_ENC=%s  ENC_OFFSET=%s  BIGRAM_OFFSET=%s",
         CORE_MODE, PERSIST_ENC, ENC_OFFSET, BIGRAM_OFFSET)
print_ln("Merge tree: %s reversal + %s oblivious + %s static swaps",
         _total_reversal_all, _total_oblivious_all, _total_static_all)
if PROFILE:
    print_ln("PROFILE: on - timers 1=read 2=merge+extract 3=enc-slab 4=R "
             "5=projection 6=norm 7=zero-phi 8=fp-sort 9=anon-search "
             "10=shuffle 11=persist 12=reveal")


def main():
    _saved_bits = program.bit_length
    program.set_bit_length(CMP_BITS)

    if CORE_MODE == 2:
        # Steps 1-2 (tail_only): read the persisted slab; merge and extraction are RNG-free, so it reconstructs exactly.
        print_ln("\n=== Steps 1-2 (tail_only): read core slab from persistence ===")
        print_ln("bigram@%s (%s x %s), encoding@%s (%s x %s)",
                 BIGRAM_OFFSET, N_CASES, ACTUAL_BIGRAMS, ENC_OFFSET, N_CASES, ENC_DIM)
        tick(2)
        bigram_matrix = sint.Matrix(N_CASES, ACTUAL_BIGRAMS)
        bigram_matrix.read_from_file(BIGRAM_OFFSET)
        encoding_matrix = sint.Matrix(N_CASES, ENC_DIM)
        encoding_matrix.read_from_file(ENC_OFFSET)
        tock(2)
    else:
        # Step 1: read the per-party event streams.
        print_ln("\n=== Step 1: Read Inputs (%s parties) ===", N_PARTIES)
        tick(1)
        activities, timestamps = read_party_inputs(N_PARTIES, N_CASES, PARTIAL_LENS)
        tock(1)
        print_ln("Read %s parties, %s events total", N_PARTIES, N_CASES * sum(PARTIAL_LENS))

        # Step 2: merge and extract, shared with secure_extract.mpc.
        print_ln("\n=== Step 2: Merge Tree + Extraction ===")
        tick(2)
        bigram_matrix, encoding_matrix = merge_and_extract(
            activities, timestamps,
            N_PARTIES, N_CASES, PARTIAL_LENS, DICT_SIZE, N_THREADS,
            ENCODING_IS_BIGRAM, encoding_extract, ENC_DIM,
            PAD_COMPOSITE, _all_level_schedules,
        )
        tock(2)

        if PERSIST_ENC:
            # ENC_OFFSET rides above every mode's write range, so the pi, Y, backbone and label offsets are untouched.
            print_ln("\n=== Persist core encoding slab @%s (extract-once) ===", ENC_OFFSET)
            tick(3)
            encoding_matrix.write_to_file(ENC_OFFSET)
            tock(3)
            print_ln("Saved %s x %s encoding features at offset %s",
                     N_CASES, ENC_DIM, ENC_OFFSET)

    # Step 2b: sample the secret projection matrix R, uniform over {-1, +1}^(K_PROJ x ENC_DIM).
    print_ln("\n=== Step 2b: Sample secret projection matrix R ===")
    tick(4)
    R = sint.Matrix(K_PROJ, ENC_DIM)
    R.assign_vector(2 * sint.get_random_bit(size=K_PROJ * ENC_DIM) - 1)
    tock(4)

    print_ln("R sampled: %s × %s secret ±1 cells", K_PROJ, ENC_DIM)

    # Step 2c: project Y = X . R^T, one matrix-vector product per case rather than K_PROJ accumulation loops.
    print_ln("\n=== Step 2c: Project Y = X · R^T ===")
    feature_matrix = sint.Matrix(N_CASES, K_PROJ)

    tick(5)

    @for_range_opt_multithread(N_THREADS, N_CASES)
    def _(i):
        feature_matrix[i].assign_vector(R.dot(encoding_matrix[i]).get_vector())

    tock(5)
    print_ln("Projected %s rows to %s dims", N_CASES, K_PROJ)

    # Step 2c-norm: L2-normalise the rows of Y before the reveal. Leakage: the projection preserves |y|, so
    # un-normalised rows would let an adversary who knows X rows match them against the shuffled ones.
    print_ln("\n=== Step 2c-norm: L2-row-normalise (sfix) ===")

    # Exact truncation for this block only: everything here is opened, and the default probabilistic sfix truncation
    # made revealed rows differ between runs on identical inputs.
    _cisc_saved = program.options.cisc
    # CISC must be off for the swap to bite: InvertSqrt would otherwise compile its body after the restore below.
    program.options.cisc = False
    _nl_probabilistic = program.non_linear
    _nl_exact = copy.copy(_nl_probabilistic)
    _nl_exact.trunc_pr = lambda a, k, m, signed=True: _nl_exact.trunc(a, k, m, signed)
    program.non_linear = _nl_exact

    # Floor protects all-zero PAD-only rows; a Python constant, so the threaded loop can consume it.
    NORM_FLOOR = 1.0

    # Stage 1 (threaded): per-row sum of squares in sint, which avoids the sfix-mul truncation at this precision.
    sq_arr = sfix.Array(N_CASES)

    tick(6)

    @for_range_opt_multithread(N_THREADS, N_CASES)
    def _(i):
        sq_int = sint(0)
        for j in range(K_PROJ):
            v = feature_matrix[i][j]
            sq_int = sq_int + v * v
        sq_shifted = sq_int >> NORM_PRESHIFT
        sq_fx = sfix(sq_shifted)
        sq_arr[i] = (sq_fx > NORM_FLOOR).if_else(sq_fx, sfix(NORM_FLOOR))

    # Stage 2 (one batched call): InvertSqrt across all rows, amortising its Newton rounds over N_CASES.
    inv_arr = sfix.Array(N_CASES)
    inv_arr.assign_vector(mpc_math.InvertSqrt(sq_arr.get_vector()))

    # Stage 3 (threaded): apply inv_norm; underlying sint = unit_value * NORM_SCALE_INT.
    @for_range_opt_multithread(N_THREADS, N_CASES)
    def _(i):
        inv_norm = inv_arr[i]
        for j in range(K_PROJ):
            v_fx = sfix(feature_matrix[i][j])
            normed_fx = v_fx * inv_norm
            feature_matrix[i][j] = normed_fx.v

    tock(6)
    program.non_linear = _nl_probabilistic
    program.options.cisc = _cisc_saved

    print_ln("Normalised %s rows; revealed cells are unit_value * %s",
             N_CASES, NORM_SCALE_INT)

    # Zero-phi rows: an all-zero profile normalises to zero, is indistinguishable from a suppressed row and shares
    # fingerprint 0, so it must claim no backbone membership and must count as suppressed in the budget search.
    row_nonzero = sint.Array(N_CASES)

    tick(7)

    @for_range_opt_multithread(N_THREADS, N_CASES)
    def _(i):
        acc = sint(0)
        for l in range(ENC_DIM):
            acc = acc + encoding_matrix[i][l]
        row_nonzero[i] = (acc != 0)   # counts are non-negative: sum 0 iff row 0

    tock(7)

    # Step 2c-anon: bb_case[i] = 1 iff case i's profile is nonzero and shared by at least K_PRIV cases, by a scalar
    # hash of the phi row, an oblivious sort by that hash and a run-length recurrence; no profile is opened.
    bb_case = sint.Array(N_CASES)
    if not SUPPRESS:
        print_ln("K_PRIV_SELECTED %s", K_PRIV)

        @for_range_opt(N_CASES)
        def _(i):
            bb_case[i] = sint(1)
    else:
        print_ln("\n=== Step 2c-anon: Anonymous-set bit (K_PRIV=%s) ===", K_PRIV)

        # Hash weights from the Public-Input channel, read on the main tape: a thread would read a suffixed file.
        tick(8)
        hash_w = cint.Array(ENC_DIM)
        for l in range(ENC_DIM):
            hash_w[l] = public_input()

        # Profile fingerprint per case, in case order; wrap mod 2^64 is fine, both sort paths group by the low CMP_BITS.
        fp = sint.Array(N_CASES)

        @for_range_opt_multithread(N_THREADS, N_CASES)
        def _(i):
            acc = sint(0)
            for l in range(ENC_DIM):
                acc = acc + encoding_matrix[i][l] * hash_w[l]
            fp[i] = acc

        # Fingerprint sort: under local share conversion a Batcher network beats the radix sort. Width: the Batcher
        # branch masks the key to the low CMP_BITS, since an unmasked 64-bit key fragments classes and under-suppresses.
        USE_BATCHER = (program.use_split() == 2)
        if USE_BATCHER:
            assert program.bit_length == CMP_BITS, (
                "Batcher cond_swap compares at program.bit_length+1; the "
                "48-bit key requires the tape width pinned to CMP_BITS "
                "(set_bit_length above)")
            print_ln("Fingerprint sort: Batcher odd-even merge "
                     "(split-2, low-%s-bit masked key)", CMP_BITS)
            fp.assign_vector(
                fp.get_vector()
                - (fp.get_vector().right_shift(CMP_BITS, bit_length=64)
                   << CMP_BITS))
        else:
            print_ln("Fingerprint sort: radix (no split-2 share conversion; "
                     "compile with -Z 2 for the Batcher path)")

        # Sort (fingerprint, original index, nonzero flag) by fingerprint; instability is harmless, the values
        # are class-invariant.
        cnt_aug = sint.Matrix(N_CASES, 3)
        cnt_aug.set_column(0, fp.get_vector())
        cnt_aug.set_column(1, sint(regint.inc(N_CASES)))
        cnt_aug.set_column(2, row_nonzero.get_vector())
        if USE_BATCHER:
            cnt_aug.sort(key_indices=[0], batcher=True, n_threads=N_THREADS)
        else:
            cnt_aug.sort(key_indices=[0], n_bits=CMP_BITS)
        tock(8)

        # Run-length: eq, forward count, backward broadcast, compare to K_PRIV. Both scans are affine recurrences,
        # so prefix doubling composes them in log2(N) levels, bit-identical to the serial recurrence.
        tick(9)
        keys = sint.Array(N_CASES)
        keys.assign_vector(cnt_aug.get_column(0))
        eq = sint.Array(N_CASES)  # eq[i] = (key[i] == key[i-1]); eq[0] = 0
        eq[0] = sint(0)
        if N_CASES > 1:
            eq.assign_vector(
                keys.get_vector(1, N_CASES - 1) == keys.get_vector(0, N_CASES - 1),
                base=1)

        # Forward cntf[i] = eq[i]*cntf[i-1] + 1, as the prefix composition of the maps (a, b) = (eq[i], 1).
        cntf = sint.Array(N_CASES)
        cntf.assign_all(1)
        coefa = sint.Array(N_CASES)
        coefa.assign(eq)
        # Scope and break points: memory-dependency tracking covers only the first 1000 addresses of a vectorised
        # access, so at larger strides the next round's loads would be hoisted past this round's stores.
        program.open_memory_scope()
        d_step = 1
        while d_step < N_CASES:
            m = N_CASES - d_step
            a_hi = coefa.get_vector(d_step, m)
            b_hi = cntf.get_vector(d_step, m)
            a_lo = coefa.get_vector(0, m)
            b_lo = cntf.get_vector(0, m)
            cntf.assign_vector(a_hi * b_lo + b_hi, base=d_step)
            coefa.assign_vector(a_hi * a_lo, base=d_step)
            d_step *= 2
            break_point('runlen-fwd')
        program.close_memory_scope()

        # Backward rl[i] = s*rl[i+1] + (1-s)*cntf[i] with s = eq[i+1]: the mirrored suffix scan.
        sel = sint.Array(N_CASES)
        sel[N_CASES - 1] = sint(0)
        if N_CASES > 1:
            sel.assign_vector(eq.get_vector(1, N_CASES - 1), base=0)
        rl = sint.Array(N_CASES)
        program.open_memory_scope()
        rl.assign_vector((1 - sel.get_vector()) * cntf.get_vector())
        break_point('runlen-bwd-init')
        d_step = 1
        while d_step < N_CASES:
            m = N_CASES - d_step
            s_lo = sel.get_vector(0, m)
            t_lo = rl.get_vector(0, m)
            s_hi = sel.get_vector(d_step, m)
            t_hi = rl.get_vector(d_step, m)
            rl.assign_vector(s_lo * t_hi + t_lo, base=0)
            sel.assign_vector(s_lo * s_hi, base=0)
            d_step *= 2
            break_point('runlen-bwd')
        program.close_memory_scope()

        # Budget-bounded threshold: a binary search for the largest k_priv whose suppressed count fits the budget.
        # Leakage: each probe opens one bit, derivable from K_PRIV_SELECTED by monotonicity and the public schedule.
        if ADAPTIVE:
            tau_count = (TAU_NUM * N_CASES) // 10000
            lo = regint(K_PRIV)
            hi = regint(N_CASES)
            n_probes = max(1, (N_CASES - K_PRIV + 1).bit_length())
            LT_BITS = max(14, N_CASES.bit_length() + 1)
            # Suppressed = every zero-phi row plus the nonzero rows of class size < mid; nz_sorted rides the sort.
            nz_sorted = sint.Array(N_CASES)
            nz_sorted.assign_vector(cnt_aug.get_column(2))
            n_zero = sint(N_CASES) - nz_sorted.sum()
            # A zero-phi row gets effective class size N_CASES, which no midpoint undercuts; rl itself stays true.
            rl_eff = sint.Array(N_CASES)
            rl_eff.assign_vector(
                nz_sorted.get_vector() * (rl.get_vector() - N_CASES) + N_CASES)
            supp = sint.Array(N_CASES)
            for _probe in range(n_probes):
                mid = (lo + hi + regint(1)) >> 1
                midc = cint(mid)
                lt = rl_eff.get_vector().less_than(midc, bit_length=LT_BITS)
                supp.assign_vector(lt)
                ok = regint(((n_zero + supp.sum()) <= tau_count).reveal())
                lo = ok * mid + (regint(1) - ok) * lo
                hi = ok * hi + (regint(1) - ok) * (mid - regint(1))
            kpriv_rt = cint(lo)
        else:
            kpriv_rt = cint(K_PRIV)
        print_ln("K_PRIV_SELECTED %s", kpriv_rt)

        # Map the backbone bit back to case order by the perfect key: column 1 was only row-permuted, so it is exactly
        # {0..N_CASES-1} and one shuffle-then-open replaces the sort, with no key bit-decomposition and no width bound.
        idx_keys = sint.Array(N_CASES)
        idx_keys.assign_vector(cnt_aug.get_column(1))
        bits = sint.Array(N_CASES)
        bits.assign_vector(rl.get_vector() >= kpriv_rt)
        reveal_sort_checked(idx_keys, bits)
        bb_case.assign_vector(bits.get_vector())
        tock(9)

        print_ln("Anonymous-set bits computed for %s cases", N_CASES)

    # Mask zero-phi rows out of the backbone; the pinned and K_PRIV<2 paths rely on this mask alone.
    bb_case.assign_vector(bb_case.get_vector() * row_nonzero.get_vector())

    # Step 2d: one secret row shuffle of [original index | backbone bit | Y]; pi is the shuffled identity column.
    print_ln("\n=== Step 2d: Shuffle Y rows via secure_shuffle ===")
    AUG_COLS = 2 + K_PROJ
    tick(10)
    aug = sint.Matrix(N_CASES, AUG_COLS)
    aug.set_column(0, sint(regint.inc(N_CASES)))
    aug.set_column(1, bb_case.get_vector())
    for j in range(K_PROJ):
        aug.set_column(2 + j, feature_matrix.get_column(j))

    aug.secure_shuffle()
    tock(10)
    print_ln("Shuffled %s rows x %s cols", N_CASES, AUG_COLS)

    # Step 3: persist the raw bigram DFG at offset 0, where Round 2 reads it.
    print_ln("\n=== Step 3: Persist bigram DFG ===")
    tick(11)
    bigram_matrix.write_to_file(0)
    tock(11)
    print_ln("Saved %s x %s bigram features at offset 0", N_CASES, ACTUAL_BIGRAMS)

    # Step 3b: persist pi, the shuffled Y and the backbone bits for secure_relabel.mpc, whose one-hot labels follow
    # at bb_offset + N_CASES, the LABEL_OFFSET Rust passes to secure_aggregate.mpc.
    pi_offset = N_CASES * ACTUAL_BIGRAMS
    y_offset = pi_offset + N_CASES
    bb_offset = y_offset + N_CASES * K_PROJ

    pi_array = sint.Array(N_CASES)
    bb_array = sint.Array(N_CASES)
    y_shuffled = sint.Matrix(N_CASES, K_PROJ)

    pi_array.assign_vector(aug.get_column(0))
    bb_array.assign_vector(aug.get_column(1))
    for j in range(K_PROJ):
        y_shuffled.set_column(j, aug.get_column(2 + j))

    tick(11)
    pi_array.write_to_file(pi_offset)
    y_shuffled.write_to_file(y_offset)
    bb_array.write_to_file(bb_offset)
    tock(11)
    print_ln("Saved π@%s, shuffled Y@%s, backbone bits@%s", pi_offset, y_offset, bb_offset)

    # Step 4: reveal the anonymous rows only. Leakage: tail rows are zeroed by the backbone bit before the open, and no
    # per-row flag is opened, a backbone row being unit-norm and so never all-zero; only the count is opened.
    print_ln("\n=== Step 4: Reveal anonymous Y rows (hybrid reveal) ===")
    flat_output = sint.Array(N_CASES * K_PROJ)

    tick(12)

    @for_range_opt_multithread(N_THREADS, N_CASES)
    def _(i):
        for a in range(K_PROJ):
            flat_output[i * K_PROJ + a] = aug[i][1] * aug[i][2 + a]

    print_ln("N_BACKBONE %s", bb_array.sum().reveal())
    revealed = flat_output.reveal()
    tock(12)
    for row_idx in range(N_CASES):
        print_ln("ROW_START %s", row_idx)
        for a in range(K_PROJ):
            print_ln("B %s %s", a, revealed[row_idx * K_PROJ + a])
        print_ln("ROW_END")

    print_ln("=== Complete ===")
    program.set_bit_length(_saved_bits)


main()
